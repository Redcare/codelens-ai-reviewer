# LLM Provider Configuration
# Options: "mimo", "openrouter", "demo"
# "demo" mode works without any API key — it returns mock reviews
LLM_PROVIDER=demo

# API Key for your chosen provider
LLM_API_KEY=your_mimo_api_key_here

# Base URL (used for MiMo; ignored for OpenRouter)
LLM_BASE_URL=https://api.xiaomimimo.com/v1

# Model name
LLM_MODEL=mimo-v2.5
